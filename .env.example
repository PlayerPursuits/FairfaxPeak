# PostgreSQL. Locally: `docker compose up -d`. On Vercel this is set by the Neon integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fairfaxpeak"

# Public base URL used in emails and Stripe redirects
APP_URL="http://localhost:3000"

# Long random string used to sign session cookies and unsubscribe links
AUTH_SECRET="change-me-to-a-long-random-string"

# Stripe (leave blank to run in "demo billing" mode, which activates listings without payment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: pre-created Stripe Price IDs. If blank, prices are created inline ($20/mo, $200/yr).
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Vercel Blob image storage (Public store). Set automatically when you connect the store:
# either BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID. Leave blank locally to save uploads to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Email (leave SMTP_HOST blank locally to write emails to ./.outbox; required on Vercel for newsletters)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Fairfax Peak <hello@fairfaxpeak.local>"

# Shared secret for the newsletter cron endpoint (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me"
